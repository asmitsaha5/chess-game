# Backend API URL (for local development, leave empty to use proxy http://localhost:5000)
# In production, set to your Google Cloud Run service URL (e.g. https://chess-backend-xyz-uc.a.run.app)
REACT_APP_API_URL=

# Firebase Client SDK Configuration (from Firebase Console -> Project Settings -> General -> Web App)
REACT_APP_FIREBASE_API_KEY=
REACT_APP_FIREBASE_AUTH_DOMAIN=
REACT_APP_FIREBASE_PROJECT_ID=
REACT_APP_FIREBASE_STORAGE_BUCKET=
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=
REACT_APP_FIREBASE_APP_ID=
