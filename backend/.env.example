PORT=5000
NODE_ENV=development

# Allowed CORS origins (comma-separated)
CORS_ORIGIN=http://localhost:3000,http://localhost:8080,https://chess-game-as.vercel.app

# -------------------------------------------------------------
# ZERO-COST OPTION: Google Cloud Firestore (GCP Native Free Tier)
# In Cloud Run, credentials are automatically discovered via IAM!
# -------------------------------------------------------------
USE_FIRESTORE=true
FIREBASE_PROJECT_ID=your-gcp-or-firebase-project-id

# -------------------------------------------------------------
# ALTERNATIVE: PostgreSQL (Docker Compose local or Neon.tech)
# If USE_FIRESTORE is false or unset, the API uses PostgreSQL
# -------------------------------------------------------------
# USE_FIRESTORE=false
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=chess_game
# PGUSER=chess
# PGPASSWORD=chess
# DATABASE_URL=postgresql://chess:chess@localhost:5432/chess_game
